<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="thisPane" spacing="5.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mara.mybox.controller.ControlImageLiquify">
    <children>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" layoutX="10.0" layoutY="212.0" prefWrapLength="0.0" vgap="5.0">
         <children>
              <ImageView fx:id="tipsView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                      <Image url="@../buttons/Red/iconTips.png" />
                  </image>
              </ImageView>
            <Label text="%Operation" />
            <RadioButton fx:id="pushRadio" mnemonicParsing="false" selected="true" text="%Push">
               <toggleGroup>
                  <ToggleGroup fx:id="operationGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="expandRadio" mnemonicParsing="false" text="%Expand" toggleGroup="$operationGroup" />
            <RadioButton fx:id="shrinkRadio" mnemonicParsing="false" text="%Shrink" toggleGroup="$operationGroup" />
            <RadioButton fx:id="rotateRadio" mnemonicParsing="false" text="%RotateClockwise" toggleGroup="$operationGroup" />
            <RadioButton fx:id="rotateCounterRadio" mnemonicParsing="false" text="%RotateCounterClockwise" toggleGroup="$operationGroup" />
            <RadioButton fx:id="turbulenceRadio" mnemonicParsing="false" text="%Turbulence" toggleGroup="$operationGroup" />
         </children>
      </FlowPane>
      <Separator layoutX="10.0" layoutY="266.0" prefWidth="200.0" />
      <VBox spacing="2.0">
         <children>
            <Label minHeight="-Infinity" text="%LiquifyNotes" wrapText="true" />
            <Label minHeight="-Infinity" text="%StartPoint" wrapText="true" />
            <FlowPane hgap="2.0" minHeight="-Infinity" prefWrapLength="100.0" vgap="2.0">
               <children>
                  <Label text="x1">
                     <FlowPane.margin>
                        <Insets />
                     </FlowPane.margin>
                  </Label>
                  <TextField prefWidth="100.0" fx:id="x1Input" />
               </children>
            </FlowPane>
            <FlowPane hgap="2.0" minHeight="-Infinity" prefWrapLength="100.0" vgap="2.0">
               <children>
                  <Label text="y1" />
                  <TextField fx:id="y1Input" prefWidth="100.0" />
               </children>
            </FlowPane>
            <Label minHeight="-Infinity" text="%EndPoint" wrapText="true" />
            <FlowPane hgap="2.0" minHeight="-Infinity" prefWrapLength="100.0" vgap="2.0">
               <children>
                  <Label text="x2">
                     <FlowPane.margin>
                        <Insets />
                     </FlowPane.margin>
                  </Label>
                  <TextField prefWidth="100.0" fx:id="x2Input" />
               </children>
            </FlowPane>
            <FlowPane hgap="2.0" minHeight="-Infinity" prefWrapLength="100.0" vgap="2.0">
               <children>
                  <Label text="y2" />
                  <TextField fx:id="y2Input" prefWidth="100.0" />
               </children>
            </FlowPane>
            <Button fx:id="goPointButton" mnemonicParsing="false" onAction="#goPointAction">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../buttons/Red/iconGo.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </VBox>
      <Separator prefWidth="200.0" />
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%FalloffAlgorithm" />
            <ComboBox fx:id="fallOffSelector" prefWidth="150.0" />
         </children>
      </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%SamplingAlgorithm" />
            <ComboBox fx:id="samplerSelector" prefWidth="150.0" />
         </children>
      </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%EdgeMode" />
            <ComboBox fx:id="edgeSelector" prefWidth="150.0" />
         </children>
      </FlowPane>
        <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
            <children>
                <Label text="%BrushRadius" />
                <ComboBox fx:id="radiusSelector" editable="true" prefWidth="100.0" />
            </children>
        </FlowPane>
        <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
            <children>
                <Label text="%Interval" />
                <ComboBox fx:id="stepSelector" editable="true" prefWidth="100.0" />
            </children>
        </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%DistortionStrength" />
            <ComboBox fx:id="strengthSelector" editable="true" prefWidth="100.0" />
         </children>
      </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%StrengthThreshold" />
            <ComboBox fx:id="strengthThresholdSelector" editable="true" prefWidth="100.0" />
         </children>
      </FlowPane>
      <VBox fx:id="setBox" spacing="2.0">
         <children>
            <FlowPane fx:id="expandShrinkPane" alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
               <children>
                  <Label text="%ExpandShrinkPower" />
                  <ComboBox fx:id="expandShrinkPowerSelector" editable="true" prefWidth="100.0" />
               </children>
            </FlowPane>
            <FlowPane fx:id="rotatePane" alignment="CENTER_LEFT" hgap="5.0" layoutX="10.0" layoutY="35.0" prefWrapLength="0.0" vgap="5.0">
               <children>
                  <Label text="%RotatePower" />
                  <ComboBox fx:id="rotatePowerSelector" editable="true" prefWidth="100.0" />
               </children>
            </FlowPane>
            <VBox fx:id="turbulenceBox" spacing="2.0">
               <children>
                  <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
                     <children>
                        <Label text="%TurbulencePower" />
                        <ComboBox fx:id="turbulencePowerSelector" editable="true" prefWidth="100.0" />
                     </children>
                  </FlowPane>
                  <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
                     <children>
                        <Label text="%TurbulenceNoiseFrequency" />
                        <ComboBox fx:id="noiseFrequencySelector" editable="true" prefWidth="100.0" />
                     </children>
                  </FlowPane>
                  <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
                     <children>
                        <Label text="%TurbulenceLayers" />
                        <ComboBox fx:id="turbulenceLayersSelector" editable="true" prefWidth="100.0" />
                     </children>
                  </FlowPane>
               </children>
            </VBox>
            <FlowPane fx:id="hardnessPane" alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
               <children>
                  <Label text="%Hardness" />
                  <ComboBox fx:id="hardnessSelector" editable="true" prefWidth="100.0" />
               </children>
            </FlowPane>
         </children>
      </VBox>
    </children>
</VBox>
