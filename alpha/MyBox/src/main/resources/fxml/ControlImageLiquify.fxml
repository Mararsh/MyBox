<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="thisPane" spacing="5.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mara.mybox.controller.ControlImageLiquify">
    <children>
        <ImageView fx:id="tipsView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../buttons/Red/iconTips.png" />
            </image>
        </ImageView>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" layoutX="10.0" layoutY="35.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%Brush" />
            <ComboBox editable="true" prefWidth="150.0" fx:id="xSelector1" />
         </children>
      </FlowPane>
        <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
            <children>
                <Label text="%Radius" />
                <ComboBox editable="true" prefWidth="100.0" fx:id="xSelector" />
            </children>
        </FlowPane>
        <FlowPane alignment="CENTER_LEFT" hgap="5.0" prefWrapLength="0.0" vgap="5.0">
            <children>
                <Label text="%Interval" />
                <ComboBox fx:id="ySelector" editable="true" prefWidth="100.0" />
            </children>
        </FlowPane>
      <FlowPane alignment="CENTER_LEFT" hgap="5.0" layoutX="10.0" layoutY="83.0" prefWrapLength="0.0" vgap="5.0">
         <children>
            <Label text="%Strength" />
            <ComboBox fx:id="ySelector1" editable="true" prefWidth="100.0" />
         </children>
      </FlowPane>
    </children>
</VBox>
